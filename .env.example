# Copy to .env.local and fill in. See docs/ENV.md for details.
# Never commit .env.local or real keys.

# Auth (Clerk) — optional for keyless dev; set for production
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# Core app secrets
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
TAVILY_API_KEY=your_tavily_api_key
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Omni provider switch (default Groq for development)
OMNI_PROVIDER=groq
# Optional: run a lightweight second-pass refinement on post-processed output
# OMNI_POSTPROCESS_REFINE=false

# Optional OpenRouter overrides for Omni route keys
# OPENROUTER_OMNI_MODEL_SIMPLE=openai/gpt-4o-mini
# OPENROUTER_OMNI_MODEL_CODING=openai/gpt-4o-mini
# OPENROUTER_OMNI_MODEL_HEAVY_REASONING=anthropic/claude-3.7-sonnet
# OPENROUTER_OMNI_MODEL_COMPLEX_WRITING=google/gemini-2.0-flash-001

# Optional
# FIRECRAWL_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# E2B_API_KEY=
